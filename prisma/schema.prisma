generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  whatsapp      String
  address       String
  note          String?
  totalPrice    Int
  status        String      @default("PENDING")
  paymentStatus String      @default("UNPAID")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id              Int    @id @default(autoincrement())
  orderId         Int
  productId       Int
  name            String
  price           Int
  quantity        Int
  originalPrice   Int
  discountPercent Int    @default(0)
  packaging       String
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  image       String?

  // Foto khusus kemasan
  cupImage    String?
  bottleImage String?

  // Kategori produk
  category String @default("COFFEE")

  // Harga
  price       Int
  cupPrice    Int?
  bottlePrice Int?

  discountPercent Int     @default(0)
  isAvailable     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
